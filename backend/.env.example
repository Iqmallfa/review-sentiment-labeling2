APP_NAME=Review Sentiment Labelling API
ENVIRONMENT=development
REVIEW_CSV_PATH=data/raw/review_cleaned.csv
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=dev-secret-key-change-this
